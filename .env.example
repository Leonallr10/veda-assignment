# Hugging Face Inference — primary extract + optional bbox repair (default for prod and dev)
# Token must be fine-grained with "Make calls to Inference Providers" permission.
# Model uses Novita provider (same as HF InferenceClient Python examples).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_QWEN_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct:novita

# Groq — grading + overall feedback (text only)
# Use a model listed in https://console.groq.com/docs/models for your account
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Recheck / eval
# RECHECK_BASE=http://localhost:3000
# RECHECK_USE_CACHE=1
# EVAL_STRICT=1

# Legacy local Qwen extract (offline dev only — requires npm run extract:local)
# USE_LEGACY_LOCAL_EXTRACT=1
# LOCAL_EXTRACT_URL=http://127.0.0.1:8001

# ChemVLM specialist — local GPU only; auto-starts with `npm run dev` when enabled
# USE_CHEM_VLM=1
# CHEM_VLM_URL=http://127.0.0.1:8002   # optional; defaults to 127.0.0.1:8002
# CHEM_VLM_MODEL=AI4Chem/ChemVLM-8B
# Do NOT set USE_CHEM_VLM on Vercel (HF Scout handles extract in production).
